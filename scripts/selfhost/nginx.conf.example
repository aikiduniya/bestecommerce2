# /etc/nginx/sites-available/store — replace yourstore.com; certbot adds the ssl_certificate lines.
limit_req_zone $binary_remote_addr zone=store_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=store_api:10m rate=60r/m;

upstream store_app { server 127.0.0.1:3000; keepalive 32; }

server {
  listen 80;
  server_name yourstore.com www.yourstore.com;
  location /.well-known/acme-challenge/ { root /var/www/html; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl http2;
  server_name yourstore.com www.yourstore.com;
  # ssl_certificate /etc/letsencrypt/live/yourstore.com/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/yourstore.com/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  client_max_body_size 20m;

  proxy_http_version 1.1;
  proxy_set_header Connection "";
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

  location = /auth { limit_req zone=store_auth burst=10 nodelay; proxy_pass http://store_app; }
  # Stripe needs the raw, unmodified body.
  location = /api/public/stripe-webhook { proxy_request_buffering off; proxy_pass http://store_app; }
  location /api/ { limit_req zone=store_api burst=30 nodelay; proxy_pass http://store_app; }
  location /assets/ { proxy_pass http://store_app; expires 1y; add_header Cache-Control "public, immutable"; }
  location / { proxy_pass http://store_app; }
}
