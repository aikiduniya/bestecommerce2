# ---------------------------------------------------------------------------
# Example environment for SELF-HOSTING. Copy to `.env` (build) and to the
# server's process environment (runtime). NO real credentials in this file.
# ---------------------------------------------------------------------------

# --- Public website -------------------------------------------------------
# Fallback canonical origin. Admin → Settings → Store → "Primary website URL"
# overrides this. HTTPS, no trailing slash.
SITE_URL=https://www.yourstore.com

# --- Database / Auth / Storage (Supabase-compatible stack) ----------------
# Browser build-time values (embedded in the client bundle — public by design).
VITE_SUPABASE_URL=https://api.yourstore.com
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server runtime values (read only inside server functions / routes).
SUPABASE_URL=https://api.yourstore.com
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Privileged key — NEVER expose to the browser, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Secret encryption ----------------------------------------------------
# AES-256-GCM key used to encrypt SMTP passwords and Stripe keys at rest.
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Changing it makes previously saved SMTP/Stripe secrets unreadable (re-enter them).
SMTP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# --- Node server ----------------------------------------------------------
PORT=3000
HOST=127.0.0.1
NODE_ENV=production

# --- Build target ---------------------------------------------------------
# node-server (VPS / cPanel Node app) or cloudflare-module (Cloudflare Workers)
NITRO_PRESET=node-server

# Stripe keys and SMTP credentials are NOT environment variables:
# enter them in Admin → Payments and Admin → Email Settings (stored encrypted).
